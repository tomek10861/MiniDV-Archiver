# Optional basic-auth for ui-proxy — off by default (docker/auth.d is empty and
# git-ignored, so a fresh checkout runs with no auth at all). To turn it on for an
# internet-facing deployment (e.g. behind a Cloudflare Tunnel):
#
#   mkdir -p docker/auth.d
#   cat > docker/auth.d/basic-auth.conf <<'EOF'
#   auth_basic "Private";
#   auth_basic_user_file /etc/nginx/auth.d/htpasswd;
#   EOF
#   openssl passwd -apr1 'a-strong-random-password' # repeat per user
#   echo "someuser:<hash-from-above>" >> docker/auth.d/htpasswd
#
# then recreate the container: docker compose up -d --no-deps ui-proxy
# (no restart needed for later password changes — nginx reads the file per request)
