[Unit]
Description=MiniDV archival capture and web API
After=network-online.target srv-minidv.mount
RequiresMountsFor=/srv/minidv

[Service]
Type=simple
User=root
WorkingDirectory=/opt/minidv-archive
EnvironmentFile=-/etc/minidv-archive.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m minidv_archiver.server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/minidv
ProtectHome=true

[Install]
WantedBy=multi-user.target
