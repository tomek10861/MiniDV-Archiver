# Copy to .env and adjust. All values are optional — these are the defaults.
# The service also reads /etc/minidv-archive.env when installed via scripts/install.sh.

# --- storage ---------------------------------------------------------------
MINIDV_STORAGE=/srv/minidv          # archive root (needs tens/hundreds of GB free)
MINIDV_MIN_FREE_GIB=80              # refuse to start a capture below this much free space

# --- camera / FireWire --------------------------------------------------
MINIDV_CAMERA_GUID=                 # empty = auto-detect first AV/C tape device; else a 16-hex GUID
MINIDV_ALLOW_FCP=1                  # 1 = drive transport over AV/C (auto PLAY/STOP/REW)
                                   # 0 = manual mode: you press PLAY/STOP on the camera
                                   #     (use 0 for cameras that reset the bus on FCP, e.g. Sony DCR-PC2E)
MINIDV_CAMERA_WAIT_TIMEOUT=20       # seconds to wait for a flapping camera to appear before failing

# --- capture end-of-tape detection ------------------------------------
MINIDV_NO_SIGNAL_TIMEOUT=45         # stop N s after the DV signal stops entirely
MINIDV_BLANK_TAIL_TIMEOUT=120       # stop after N s of nothing-but-blank frames (recording ended)
MINIDV_CAPTURE_IDLE_TIMEOUT=300     # hard backstop: N s with no new DV bytes
MINIDV_CAPTURE_MAX_SECONDS=9000     # absolute cap on one capture
MINIDV_PLAY_WAIT_TIMEOUT=300        # in manual mode, how long to wait for you to press PLAY
MINIDV_MAX_DVGRAB_RESTARTS=40       # relaunch dvgrab this many times across blank stretches
MINIDV_REWIND_TIMEOUT=420           # auto-rewind timeout (AV/C mode only)
MINIDV_KEEP_PARTIAL_MIN_SECONDS=20  # a manual "stop" with at least this much DV is archived, not dropped

# --- encoding -----------------------------------------------------------
MINIDV_ZSTD_LEVEL=6                 # master compression level for .dv.zst
MINIDV_MP4_PRESET=medium            # x264 preset for scene proxies (veryfast ~4-6x faster, bigger)
# The DV recording date has no timezone of its own -- it's whatever the camera's
# clock was set to (almost always local/wall-clock time). This names that zone, so
# it converts correctly to a real UTC instant instead of being wrongly labeled "Z"
# in place. Per-capture override: the "Napraw"/capture-start form's timezone field.
# Falls back to the generic TZ var, then Europe/Warsaw if that's unset or bare UTC
# (the common Docker default -- never actually where the camera was).
MINIDV_DEFAULT_RECORDING_TZ=Europe/Warsaw
MINIDV_NICE_PROCESSING=1            # nice/ionice the pipeline so a concurrent capture never underruns
MINIDV_SHARE_MAX_MB=90              # target size for the on-demand "share" re-encode
MINIDV_SHARE_CRF=23
MINIDV_SHARE_PRESET=veryfast

# --- optional "restore" variant (🧹 Napraw) -------------------------
# Denoise/repair MP4 built from the DV master(s), never the proxy. The whole
# ffmpeg -vf chain is yours to tune; bwdif here also does the deinterlace.
MINIDV_RESTORE_FILTERS=bwdif=mode=send_field:parity=bff:deint=all,atadenoise,deblock=filter=strong:block=8
MINIDV_RESTORE_CRF=18
MINIDV_RESTORE_PRESET=medium
MINIDV_RESTORE_DECIMATE=0           # 1 = also mpdecimate (drop duplicated frames; makes the stream VFR)
# Two optional per-job additions, checked as boxes on the "Napraw" button — both
# off unless asked for, and pure tail additions to the -vf chain above (nothing
# here changes what plain "Napraw" does). Stabilization needs nothing extra;
# upscale needs a working GPU (ffmpeg's libplacebo filter, over Vulkan) in the
# converter container — see compose.override.yaml.example.
MINIDV_STABILIZE_SHAKINESS=8        # 1-10, how hard pass 1 looks for shake (vidstab default 5)
MINIDV_STABILIZE_SMOOTHING=20       # how strongly pass 2 flattens the camera path (vidstab default 15)
MINIDV_UPSCALE_FACTOR=2             # linear scale factor (2 = 720x576 -> 1440x1152 for PAL DV)
MINIDV_UPSCALE_SCALER=ewa_lanczos4sharpest   # libplacebo's sharpest built-in kernel

# --- face recognition ("Osoby" / People) -----------------------------
# CPU-only OpenCV (YuNet detector + SFace embedder), models baked into the image.
# Persons are per workspace. One scan at a time (cron or a click); progress is kept
# per scene, so a stopped scan continues where it left off. Pauses during captures.
MINIDV_FACES=1                      # 0 = feature off (no schedule, scan refused)
MINIDV_FACES_SCAN_AT=03:00          # daily scan of new scenes, local time (DEFAULT_RECORDING_TZ);
                                   # only starts within 6 h of this; empty = no schedule
MINIDV_FACES_THREADS=1              # OpenCV threads for the scanner
MINIDV_FACES_BLUR=40                # per second, the first frame this sharp (Laplacian variance) is analysed
MINIDV_FACES_MIN_SIZE=36            # ignore faces smaller than this (px)
MINIDV_FACES_SCORE=0.8              # detector confidence
MINIDV_FACES_MATCH=0.40             # fast scan only: SFace cosine for "same person"
# After the fast scan, a detailed pass (ArcFace on the best views of every face)
# regroups everything. Tuned on real DV footage; only touch with care:
MINIDV_FACES_CORE_FRONTAL=0.4       # how frontal (0-1) a face must be to build groups
MINIDV_FACES_CLUSTER=0.24           # groups join at this average similarity (lower = more mixing)
MINIDV_FACES_ATTACH=0.32            # profile/blurry faces join a group only at this similarity...
MINIDV_FACES_ATTACH_MARGIN=0.05     # ...and this far ahead of the next-best group

# --- photos & videos from cameras / phones ("Zdjęcia i filmy") ------------
# Comma-separated folders as the containers see them, mounted read-only (see
# compose.override.yaml.example). Nothing in them is ever written: thumbnails,
# browser copies of HEIC photos and H.264 copies of unplayable videos go to
# <storage>/media. They appear on the timeline and in face recognition too.
MINIDV_MEDIA_DIRS=
MINIDV_MEDIA_WORKSPACE=default
MINIDV_MEDIA_INTERVAL=300           # seconds between checks for new files
MINIDV_DVD_CRF=17                   # DVD copies: 50p, native 720x576 + pixel aspect
MINIDV_DVD_PRESET=slow

# --- server -----------------------------------------------------------
MINIDV_BIND=0.0.0.0
MINIDV_PORT=8080
